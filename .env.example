# 複製成 .env 後修改，或直接設定環境變數。所有項目都有預設值。
# 使用 .env 時請以 node --env-file=.env dist/server/index.js 啟動。

# 伺服器監聽的連接埠
PORT=3000

# 放在反向代理或雲端平台（Cloud Run、Render、Nginx 等）後面時務必設為 1，
# 否則所有玩家會被視為同一個 IP，共用同一份限流額度。
# 直接對外時請保持 0，避免用戶端偽造來源位址。
TRUST_PROXY=0

# 允許連線的其他網域（逗號分隔）。前後端同網域時不需要設定。
ALLOWED_ORIGINS=

# 同時存在的房間上限
MAX_ROOMS=2000

# 房間沒有人之後保留幾分鐘
ROOM_IDLE_TTL_MINUTES=30
