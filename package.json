{
  "name": "family-xiangqi",
  "version": "2.0.0",
  "private": true,
  "description": "親子中國象棋：可線上對戰、與 AI 練習、學棋與解殘局的網頁遊戲",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "start": "node dist/server/index.js",
    "test": "node --import tsx --test \"tests/engine/*.test.ts\" \"tests/server/*.test.ts\" \"tests/client/*.test.ts\"",
    "test:e2e": "node --import tsx --test \"tests/e2e/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run typecheck && npm run format:check",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "prettier": "3.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
